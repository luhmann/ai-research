# New Relic Configuration
NEW_RELIC_API_KEY=YOUR_API_KEY_HERE
NEW_RELIC_ACCOUNT_ID=YOUR_ACCOUNT_ID_HERE

# Polling interval in milliseconds (default: 10000)
POLLING_INTERVAL_MS=10000

# GraphQL Backend Configuration
GRAPHQL_ENDPOINT=http://localhost:4000/graphql

# Optional: GraphQL Headers as JSON
# GRAPHQL_HEADERS={"Authorization":"Bearer YOUR_TOKEN"}

# Optional: Custom NRQL query (defaults to all logs)
# NRQL_QUERY=SELECT * FROM Log WHERE service = 'my-service'
